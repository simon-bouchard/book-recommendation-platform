# .env.example — copy to .env and fill in.
#
# Covers the core app (backend, model servers, data/training scripts) plus
# the chatbot, listed below with empty/placeholder values since it's optional.
# Still not covered: the enrichment pipeline (Kafka/Spark/MinIO) and
# notifications — separate, optional subsystems with their own env vars; grep
# the codebase for `os.getenv`/`os.environ` if you need one of those.

# --- Database and Redis (required, no defaults) ---
# Ports match docker/local-db/docker-compose.yml (MySQL on 3307, Redis on 6380).
# To use native MySQL/Redis on their default ports instead, use 3306 and 6379.
# MYSQL_ROOT_PASSWORD is read by that Compose file, and must match the password in DATABASE_URL.
MYSQL_ROOT_PASSWORD=changeme
DATABASE_URL=mysql+pymysql://root:changeme@localhost:3307/bookrec_db
REDIS_URL=redis://localhost:6380/0

# --- Auth ---
# Required, no default. Generate with: openssl rand -hex 32
SECRET_KEY=changeme

# Set to false for local http development. Leave true (the default) in
# production, where cookies are served over https.
SECURE_MODE=false

# --- Meilisearch (required for search; no default) ---
# Must match whatever master key your local Meilisearch instance is configured with.
MEILI_MASTER_KEY=changeme

# --- Compose env file ---
# Env file the docker compose files in docker/ read for container variables.
# Relative paths resolve from each compose file's directory (docker/<service>/),
# so ../../.env points at this file. On the server, set it to /etc/bookrec.env.
BOOKREC_ENV_FILE=../../.env

# --- Model server artifacts ---
# Absolute path to your models/artifacts directory. Used by
# docker/model-servers/docker-compose.yml to bind-mount artifacts into each
# container (${ARTIFACTS_DIR} substitution) — required for `docker compose up`
# to work at all, not just for a specific feature.
ARTIFACTS_DIR=/absolute/path/to/book-recommendation-platform/models/artifacts

# --- Model servers ---
# Required when the backend runs outside Docker (plain uvicorn on the host).
# The code defaults to Docker service names (e.g. http://similarity:8002) which
# only resolve inside a Docker network — uncomment these for local development.
EMBEDDER_URL=http://localhost:8001
SIMILARITY_URL=http://localhost:8002
ALS_URL=http://localhost:8003
METADATA_URL=http://localhost:8004
SEMANTIC_URL=http://localhost:8005

# --- Subject attention strategy ---
# Which pooler variant's checkpoint to load (scalar | perdim | selfattn | selfattn_perdim).
# Must match whichever checkpoint you trained/have in models/artifacts/.../attention/.
ATTN_STRATEGY=perdim

# Padding index for invalid/missing subjects. Used throughout the training
# pipeline and data loaders.
PAD_IDX=0

# --- Observability ---
# Disables OpenTelemetry tracing. Leave true unless you're also running
# Jaeger (docker compose -f docker/jaeger/docker-compose.yml up -d, not part
# of the main compose stack — see README.md's Local Setup section) — with
# tracing enabled and no Jaeger running, the app will repeatedly try and fail
# to export traces to a nonexistent endpoint.
OTEL_SDK_DISABLED=true

# --- Chatbot (optional) ---
# The chatbot feature is not required for the rest of the app to work.
# Leave these empty to leave it disabled.
LLM_PROVIDER=
DEEPINFRA_API_KEY=
DEEPINFRA_BASE_URL=
OPENAI_API_KEY=
OPENAI_BASE_URL=
LLM_MODEL_SMALL=
LLM_MODEL_MEDIUM=
LLM_MODEL_LARGE=
